{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/go/:slug", "destination": "/api/go?slug=:slug" },
    { "source": "/go", "destination": "/api/go" },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "accept-language", "value": "^en(-[A-Za-z]+)?\\b.*" }
      ],
      "missing": [
        { "type": "cookie", "key": "intake_lang" },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|slurp|headless|preview).*"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    { "source": "/de", "destination": "/", "permanent": false },
    { "source": "/de/:path*", "destination": "/:path*", "permanent": false },
    { "source": "/hilfe/kalorienring", "destination": "https://docs.getintake.de/calorie-ring", "permanent": true },
