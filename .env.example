# Copy to .env.local (git-ignored) for local work. Every value below is a placeholder.
#
# The VITE_ prefix means "inlined into the browser bundle and therefore public".
# Never put it on anything from the server-only section.

# --- Client (public, shipped to the browser) ---

# PostHog EU project API key (public phc_ key). Leave empty to disable analytics locally.
VITE_POSTHOG_KEY=

# --- Server only: the /go/<slug> smart link function (api/go.ts) ---
# Set these in the Vercel project's environment variables, not in a committed
# file. When they are missing the redirect still works but no click rows are
# written, and the function logs a warning naming the absent variable.

# Supabase project REST endpoint that receives the smartlink_clicks insert.
SUPABASE_URL=https://your-project.supabase.co

# SECRET — service role key. Bypasses row level security on the production
# database entirely. Server-only: never commit a real value, never expose it to
# the client, and never give it a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET — salt for the daily visitor hash (sha256 of ip|user-agent|day|secret).
# Without it visitor_hash is stored as null and click dedup falls back to click
# ids only. Server-only; do not commit a real value or prefix it with VITE_.
SMARTLINK_HASH_SECRET=some-long-random-string
