---
import { ChevronLeft, ChevronRight } from 'lucide-astro';
import { getScreenshotGalleryAssets } from '@/lib/screenshotAssets';
import { useT } from '@/i18n/t';
import type { Language } from '@/i18n/translations';

/**
 * Was an embla carousel — 23 KB of JS to scroll a row of screenshots sideways. The row
 * is CSS scroll-snap now: touch, trackpad and shift+wheel all work natively, and it
 * degrades to a plain scrollable row anywhere scroll-snap is unsupported.
 *
 * The desktop prev/next buttons are driven by src/scripts/carousel.ts. They start
 * hidden and are revealed by that script, so they never render as dead controls if it
 * fails to load — the row still scrolls either way.
 */
interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useT(lang);
const screenshots = getScreenshotGalleryAssets(lang);

const arrowClass =
  'absolute top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/[0.12] bg-background/80 text-foreground/70 backdrop-blur-sm transition-colors hover:border-white/[0.24] hover:text-foreground disabled:pointer-events-none disabled:opacity-0 md:flex';
---
<section class="py-16 md:py-20">
  <div class="container mx-auto px-0 md:px-4">
    <h2 class="mb-10 px-4 text-center text-2xl text-foreground md:px-0 md:text-3xl">
      {t('screenshotGalleryHeading')}
    </h2>

    <div data-carousel class="reveal relative px-0 md:px-12">
      <button
        type="button"
        data-carousel-prev
        hidden
        class:list={[arrowClass, 'left-0']}
        aria-label={lang === 'de' ? 'Vorherige Screenshots' : 'Previous screenshots'}
      >
        <ChevronLeft class="h-5 w-5" />
      </button>

      <ul
        data-carousel-track
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-4 pb-4 md:px-0 [scrollbar-color:hsl(var(--muted-foreground)/0.35)_transparent] [scrollbar-width:thin]"
      >
        {screenshots.map((screenshot) => (
          <li class="shrink-0 basis-[85%] snap-center sm:basis-1/2 md:basis-1/3 md:snap-start lg:basis-1/4">
            <figure>
              <img
                src={screenshot.src}
                alt={screenshot.alt}
                loading="lazy"
                decoding="async"
                class="h-auto w-full rounded-xl border border-white/[0.08]"
              />
              <figcaption class="mt-3 px-2 text-sm text-foreground/50">
                {screenshot.caption}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <button
        type="button"
        data-carousel-next
        hidden
        class:list={[arrowClass, 'right-0']}
        aria-label={lang === 'de' ? 'Weitere Screenshots' : 'More screenshots'}
      >
        <ChevronRight class="h-5 w-5" />
      </button>
    </div>
  </div>
</section>

<script>
  import '@/scripts/carousel';
</script>
