---
import { buildLocalizedPath } from "@/lib/localeRouting";
import { useT } from '@/i18n/t';
import type { Language } from '@/i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useT(lang);
---
<div class="flex min-h-screen items-center justify-center bg-muted">
        <div class="text-center">
          <h1 class="mb-4 text-4xl">404</h1>
          <p class="mb-4 text-xl text-muted-foreground">
            {lang === "de" ? "Seite nicht gefunden" : "Oops! Page not found"}
          </p>
          <a
            href={buildLocalizedPath("home", lang)}
            class="text-primary underline hover:text-primary/90"
          >
            {lang === "de" ? "Zur Startseite" : "Return to Home"}
          </a>
        </div>
      </div>
