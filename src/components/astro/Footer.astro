---
import logo from '@/assets/logo.png';
import { buildLocalizedPath } from '@/lib/localeRouting';
import { getAppStoreUrl, getGooglePlayUrl } from '@/lib/storeLinks';
import { useT } from '@/i18n/t';
import type { Language } from '@/i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useT(lang);

const FEATURE_VOTING_URL = 'https://featurevoting.tobibechtold.dev/app/intake';
const CHANGELOG_URL = 'https://featurevoting.tobibechtold.dev/app/intake/changelog';

const LINK = 'text-sm text-foreground/45 transition-colors hover:text-foreground';
const HEADING = 'text-[11px] font-semibold uppercase tracking-[0.18em] text-foreground/70';

const discover = [
  { href: buildLocalizedPath('features', lang), label: t('featuresNav') },
  { href: buildLocalizedPath('noSubscription', lang), label: t('noSubscriptionNav') },
  { href: buildLocalizedPath('noAccount', lang), label: t('noAccountNav') },
  { href: buildLocalizedPath('intakeAI', lang), label: t('intakeAINav') },
  { href: buildLocalizedPath('comparisons', lang), label: t('comparisonsNav') },
  { href: buildLocalizedPath('help', lang), label: t('helpNav') },
  { href: buildLocalizedPath('comparisonDetail', lang, 'yazio-alternative'), label: t('yazioAlternative') },
  { href: buildLocalizedPath('comparisonDetail', lang, 'fddb-alternative'), label: t('fddbAlternative') },
];

const legal = [
  { href: buildLocalizedPath('privacy', lang), label: t('privacyPolicy'), external: false },
  { href: buildLocalizedPath('terms', lang), label: t('termsOfUse'), external: false },
  { href: 'https://tobibechtold.dev/impressum', label: t('imprint'), external: true },
];

const social = [
  { href: 'https://www.instagram.com/getintake.app/', label: 'Instagram' },
  { href: 'https://www.threads.com/@getintake.app', label: 'Threads' },
];

const year = new Date().getFullYear();
---
<footer class="border-t border-white/[0.06]">
  <div class="container py-12">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row">
      <div class="flex items-center gap-3">
        <img src={logo.src} alt="Intake" class="h-8 w-8" />
        <span class="text-lg font-semibold text-foreground">Intake</span>
      </div>

      <div class="flex flex-col gap-6 md:flex-row md:gap-12">
        <div class="flex flex-col gap-3">
          <span class={HEADING}>{t('discover')}</span>
          {discover.map((item) => <a href={item.href} class={LINK}>{item.label}</a>)}
        </div>

        <div class="flex flex-col gap-3">
          <span class={HEADING}>{t('legal')}</span>
          {legal.map((item) => (
            <a
              href={item.href}
              class={LINK}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          ))}
        </div>

        <div class="flex flex-col gap-3">
          <span class={HEADING}>{t('app')}</span>
          {/* data-store-cta is read by the delegated listener in src/scripts/bootstrap.ts. */}
          <a
            href={getAppStoreUrl(lang)}
            target="_blank"
            rel="noopener noreferrer"
            data-store-cta="ios"
            data-cta-location="footer"
            class={LINK}
          >
            {t('appStore')}
          </a>
          <a
            href={getGooglePlayUrl()}
            target="_blank"
            rel="noopener noreferrer"
            data-store-cta="android"
            data-cta-location="footer"
            class={LINK}
          >
            {t('googlePlay')}
          </a>
          <a href={buildLocalizedPath('whatsNewIndex', lang)} class={LINK}>{t('whatsNew')}</a>
          <a href={FEATURE_VOTING_URL} target="_blank" rel="noopener noreferrer" class={LINK}>
            {t('featureVotingNav')}
          </a>
          <a href={CHANGELOG_URL} target="_blank" rel="noopener noreferrer" class={LINK}>
            {t('changelog')}
          </a>
        </div>

        <div class="flex flex-col gap-3">
          <span class={HEADING}>{t('social')}</span>
          {social.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer" class={LINK}>
              {item.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-white/[0.06] pt-6">
      <p class="text-center text-xs text-foreground/35">
        © {year} Intake. {t('allRightsReserved')}
      </p>
    </div>
  </div>
</footer>
