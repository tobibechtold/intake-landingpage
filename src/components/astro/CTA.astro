---
import appStoreBadge from '@/assets/app-store-badge.svg';
import googlePlayBadge from '@/assets/google-play-badge.png';
import { getAppStoreUrl, getGooglePlayUrl } from '@/lib/storeLinks';
import { useT } from '@/i18n/t';
import type { Language } from '@/i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useT(lang);
---
<section id="cta" class="py-24">
  <div class="container">
    <div class="glass-card reveal mx-auto max-w-3xl p-12 text-center md:p-16">
      <h2 class="mb-4 text-3xl text-foreground md:text-4xl">{t('ctaTitle')}</h2>
      <p class="mx-auto mb-8 max-w-lg text-lg text-foreground/50">{t('ctaDescription')}</p>

      {/* data-store-cta is read by the delegated listener in src/scripts/bootstrap.ts —
          static markup has no onClick, so tracking is attribute-driven. */}
      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={getAppStoreUrl(lang)}
          target="_blank"
          rel="noopener noreferrer"
          data-store-cta="ios"
          data-cta-location="cta"
          class="inline-block transition-opacity hover:opacity-80"
        >
          <img src={appStoreBadge.src} alt="Download on the App Store" class="h-12 md:h-14" />
        </a>

        <a
          href={getGooglePlayUrl()}
          target="_blank"
          rel="noopener noreferrer"
          data-store-cta="android"
          data-cta-location="cta"
          class="inline-block transition-opacity hover:opacity-80"
        >
          <img src={googlePlayBadge.src} alt="Get it on Google Play" class="h-12 md:h-14" />
        </a>
      </div>
    </div>
  </div>
</section>
