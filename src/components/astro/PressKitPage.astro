---
import { Download, ExternalLink, KeyRound, Mail, Newspaper, Quote } from 'lucide-astro';
import PageBreadcrumbs from '@/components/astro/PageBreadcrumbs.astro';
import { PRESS_MENTIONS, getPressMentionLabel } from '@/lib/pressMentions';
import { buildLocalizedPath } from '@/lib/localeRouting';
import { useT } from '@/i18n/t';
import type { Language } from '@/i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useT(lang);

const PRESS_EMAIL = 'press@tobibechtold.dev';
const APP_STORE_URL = 'https://apps.apple.com/de/app/id6757768955';
const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=de.bechtoldit.intake';

/**
 * Assets that are not in `public/` yet render as "in preparation" instead of a
 * dead link. A broken download in a press kit is worse than a missing one.
 */
const DOWNLOADS = [
  { key: 'shotsIos', href: null, ready: false },
  { key: 'shotsAndroid', href: '/presskit/screenshots_android.zip', ready: true },
  { key: 'icon', href: '/presskit/intake-iOS-Default-1024x1024@1x.png', ready: true },
] as const;

const SCREENSHOT_SLUGS = [
  '2-Dashboard',
  '4-Add-Food',
  '6-Scan-Food',
  '10-Statistics',
] as const;

const CONTENT = {
  de: {
    breadcrumb: 'Presse',
    kicker: 'Pressematerial',
    title: 'Presse',
    intro:
      'Alles, was für einen Artikel über Intake gebraucht wird: Fakten, fertige Beschreibungen, Zitate und Screenshots. Alles frei verwendbar, ohne Rückfrage.',
    badge: 'Rezensionsexemplar? Einfach kurz eine Mail, Promo-Codes gibt es sofort.',

    factsTitle: 'Fakten',
    facts: [
      ['Name', 'Intake: Kalorienzähler & Diät'],
      ['Kurzbeschreibung', 'Kalorienzähler ohne Abo, ohne Account und ohne Bullshit'],
      ['Preis', '6,99 € einmalig. Kein Abo, keine Premium-Wall.'],
      ['Intake AI', 'Optionales Abo, alternativ mit eigenem API-Key nutzbar'],
      ['Plattformen', 'iOS, iPadOS, Apple Watch, Android'],
      ['Technik', 'Nativ: Swift/SwiftUI auf iOS, Kotlin/Jetpack Compose auf Android'],
      ['Entwickler', 'Tobias Bechtold, Indie-Entwickler aus Deutschland'],
      ['Sprachen', 'Deutsch, Englisch, Spanisch, Französisch, Italienisch, Japanisch, Niederländisch, Portugiesisch'],
      ['Datenbank', 'Rund 3 Mio. Lebensmittel, in der EU gehostet, täglich aktualisiert'],
      ['Datenquellen', 'Open Food Facts, Bundeslebensmittelschlüssel, USDA'],
      ['Konto', 'Keins. Alle Daten bleiben auf dem Gerät.'],
      ['Sync', 'Optional, Ende-zu-Ende-verschlüsselt über iCloud oder Google Drive'],
      ['Health', 'Apple Health (iOS) und Health Connect (Android)'],
    ],

    descriptionsTitle: 'Fertige Beschreibungen',
    descriptionsIntro: 'Zum direkten Übernehmen, in drei Längen.',
    descLabels: ['Eine Zeile', 'Ein Absatz', 'Ausführlich'],
    descriptions: [
      'Intake ist ein Kalorienzähler ohne Abo, ohne Account und ohne Gamification, zum Einmalpreis von 6,99 Euro.',
      'Intake ist ein Kalorienzähler für iOS und Android, der ohne Abo, ohne Account und ohne Gamification auskommt. Die App kostet einmalig 6,99 Euro, alle Daten bleiben auf dem Gerät, und die Lebensmittel-Datenbank mit rund 3 Millionen Einträgen ist in der EU gehostet. Optionale KI-Funktionen lassen sich wahlweise über ein Abo oder mit einem eigenen API-Schlüssel nutzen.',
      'Intake ist ein Kalorienzähler für iOS und Android, entwickelt von einem einzelnen Entwickler aus Deutschland. Anders als die großen Anbieter kommt Intake ohne Abo aus: Die App kostet einmalig 6,99 Euro und hat keine Premium-Wall, keine Streaks, keine Punkte und keine ungefragten Ernährungstipps. Es gibt kein Kontosystem, alle Daten bleiben auf dem Gerät, ein optionales Backup über iCloud oder Google Drive ist Ende zu Ende verschlüsselt. Die Lebensmittel-Datenbank umfasst rund 3 Millionen Einträge aus Open Food Facts, dem Bundeslebensmittelschlüssel und der USDA-Datenbank, ist in der EU gehostet und wird täglich aktualisiert. Die optionalen KI-Funktionen erfassen Mahlzeiten per Foto oder Text und lassen sich entweder über ein Abo oder mit einem eigenen API-Schlüssel von ChatGPT, Claude oder Gemini nutzen. Beide Plattform-Apps sind nativ gebaut und auf demselben Funktionsstand.',
    ],

    storyTitle: 'Die Geschichte dahinter',
    storyQuote:
      'Ich habe selbst ordentlich abgenommen und dafür zuerst nach einer App gesucht. Aber alle kamen mit Abo, Gamification und Coaching-Features, die einen bei der Stange halten sollen. Bei Yazio ist man schnell bei 40 bis 80 Euro im Jahr. Also habe ich meine eigene App gebaut: einen Kalorienzähler ohne Abo, ohne Account und ohne Bullshit.',
    storyAttribution: 'Tobias Bechtold, Entwickler von Intake',

    byokTitle: 'KI ohne KI-Abo',
    byokBody:
      'Fast jede App in dieser Kategorie hat inzwischen KI-Features bekommen, und fast immer als zweites Abo obendrauf. Intake geht einen anderen Weg: Die KI-Funktionen gibt es als optionales Abo, man kann sie aber genauso mit einem eigenen API-Schlüssel von ChatGPT, Claude oder Gemini nutzen. Dann zahlt man die tatsächlichen Kosten direkt beim Anbieter, in der Praxis meist ein paar Cent im Monat.',
    byokQuote: 'Und ich verdiene daran keinen Cent.',
    byokNote: 'Nach unserem Kenntnisstand ist Intake der einzige Kalorienzähler, der das anbietet.',

    downloadsTitle: 'Downloads',
    downloadsIntro:
      'Alle Materialien dürfen ohne Rückfrage für die Berichterstattung verwendet werden.',
    downloads: {
      shotsIos: { label: 'Screenshots iOS (ZIP)', note: 'Mit und ohne Rahmen, Deutsch und Englisch' },
      shotsAndroid: { label: 'Screenshots Android (ZIP)', note: 'Mit und ohne Rahmen, Deutsch und Englisch' },
      icon: { label: 'App-Icon', note: 'PNG, 1024 × 1024' },
    },
    pending: 'In Vorbereitung',
    screenshotsPreview: 'Auswahl aus dem Screenshot-Paket',

    coverageTitle: 'Bisherige Berichterstattung',

    contactTitle: 'Kontakt',
    contactBody:
      'Fragen, Interviewanfragen oder ein Rezensionsexemplar: einfach kurz schreiben. Promo-Codes für App Store und Play Store gibt es auf Anfrage sofort.',
    contactCta: 'E-Mail schreiben',
    storeCtaIos: 'Im App Store ansehen',
    storeCtaAndroid: 'Bei Google Play ansehen',
    copy: 'Kopieren',
    copied: 'Kopiert',
  },
  en: {
    breadcrumb: 'Press',
    kicker: 'Press resources',
    title: 'Press',
    intro:
      'Everything you need to write about Intake: facts, ready-made descriptions, quotes and screenshots. All free to use, no need to ask.',
    badge: 'Need a review copy? Send a short email and you get promo codes right away.',

    factsTitle: 'Facts',
    facts: [
      ['Name', 'Intake: Calorie Counter & Diet'],
      ['Short description', 'A calorie counter with no subscription, no account and no nonsense'],
      ['Price', '€6.99 once. No subscription, no premium wall.'],
      ['Intake AI', 'Optional subscription, or bring your own API key'],
      ['Platforms', 'iOS, iPadOS, Apple Watch, Android'],
      ['Technology', 'Native: Swift/SwiftUI on iOS, Kotlin/Jetpack Compose on Android'],
      ['Developer', 'Tobias Bechtold, indie developer based in Germany'],
      ['Languages', 'German, English, Spanish, French, Italian, Japanese, Dutch, Portuguese'],
      ['Database', 'Around 3 million foods, hosted in the EU, updated daily'],
      ['Data sources', 'Open Food Facts, Bundeslebensmittelschlüssel, USDA'],
      ['Account', 'None. All data stays on the device.'],
      ['Sync', 'Optional, end-to-end encrypted via iCloud or Google Drive'],
      ['Health', 'Apple Health (iOS) and Health Connect (Android)'],
    ],

    descriptionsTitle: 'Ready-made descriptions',
    descriptionsIntro: 'Copy and paste, in three lengths.',
    descLabels: ['One line', 'One paragraph', 'Long form'],
    descriptions: [
      'Intake is a calorie counter with no subscription, no account and no gamification, for a one-time price of €6.99.',
      'Intake is a calorie counter for iOS and Android that works without a subscription, without an account and without gamification. The app costs €6.99 once, all data stays on the device, and the food database of around 3 million items is hosted in the EU. Optional AI features can be used either through a subscription or with your own API key.',
      'Intake is a calorie counter for iOS and Android, built by a single developer in Germany. Unlike the larger apps in the category, Intake has no subscription: it costs €6.99 once and has no premium wall, no streaks, no points and no unsolicited nutrition advice. There is no account system, all data stays on the device, and an optional backup via iCloud or Google Drive is end-to-end encrypted. The food database holds around 3 million items from Open Food Facts, the German Bundeslebensmittelschlüssel and the USDA database, is hosted in the EU and updated daily. Optional AI features log meals from a photo or a text description, and can be used either through a subscription or with your own API key from ChatGPT, Claude or Gemini. Both platform apps are built natively and are at the same feature level.',
    ],

    storyTitle: 'The story behind it',
    storyQuote:
      'I lost a good amount of weight myself and went looking for an app to help. But every one of them came with a subscription, gamification and coaching features designed to keep you hooked. With Yazio you are quickly at 40 to 80 euros a year. So I built my own: a calorie counter with no subscription, no account and no nonsense.',
    storyAttribution: 'Tobias Bechtold, developer of Intake',

    byokTitle: 'AI without an AI subscription',
    byokBody:
      'Almost every app in this category has added AI features by now, and almost always as a second subscription on top. Intake takes a different route: the AI features are available as an optional subscription, but you can just as well run them with your own API key from ChatGPT, Claude or Gemini. You then pay the actual cost directly to the provider, in practice usually a few cents a month.',
    byokQuote: 'And I do not earn a cent from it.',
    byokNote: 'As far as we know, Intake is the only calorie counter that offers this.',

    downloadsTitle: 'Downloads',
    downloadsIntro: 'All materials may be used for coverage without asking first.',
    downloads: {
      shotsIos: { label: 'Screenshots iOS (ZIP)', note: 'Framed and unframed, German and English' },
      shotsAndroid: { label: 'Screenshots Android (ZIP)', note: 'Framed and unframed, German and English' },
      icon: { label: 'App icon', note: 'PNG, 1024 × 1024' },
    },
    pending: 'In preparation',
    screenshotsPreview: 'A selection from the screenshot pack',

    coverageTitle: 'Coverage so far',

    contactTitle: 'Contact',
    contactBody:
      'Questions, interview requests or a review copy: just drop a short email. Promo codes for the App Store and Play Store are available immediately on request.',
    contactCta: 'Send an email',
    storeCtaIos: 'View on the App Store',
    storeCtaAndroid: 'View on Google Play',
    copy: 'Copy',
    copied: 'Copied',
  },
} as const;

const content = CONTENT[lang];
const shotPrefix = lang === 'de' ? 'de' : 'en';

const breadcrumbs = [
  { label: t('homeNav'), href: buildLocalizedPath('home', lang) },
  { label: content.breadcrumb },
];
---
<div class="min-h-screen">
  <main class="pb-24 pt-28">
    <section class="hero-gradient border-b border-white/[0.08] pb-16 pt-8 md:pb-20">
      <div class="container max-w-6xl">
        <PageBreadcrumbs items={breadcrumbs} />
        <div class="max-w-4xl">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white/[0.05] text-foreground/70">
            <Newspaper class="h-7 w-7" aria-hidden="true" />
          </div>
          <p class="section-kicker mt-6">{content.kicker}</p>
          <h1 class="mt-3 text-4xl leading-tight text-foreground md:text-6xl">{content.title}</h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground md:text-xl">{content.intro}</p>
          <p class="badge-accent mt-5">{content.badge}</p>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="container max-w-6xl">
        <h2 class="text-3xl text-foreground md:text-4xl">{content.factsTitle}</h2>
        <dl class="mt-8 grid gap-x-10 gap-y-0 md:grid-cols-2">
          {content.facts.map(([term, value]) => (
            <div class="flex flex-col gap-1 border-b border-white/[0.06] py-4">
              <dt class="text-xs uppercase tracking-[0.12em] text-foreground/45">{term}</dt>
              <dd class="text-[15px] leading-7 text-foreground/90">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section-gradient py-16 md:py-20">
      <div class="container max-w-6xl">
        <h2 class="text-3xl text-foreground md:text-4xl">{content.descriptionsTitle}</h2>
        <p class="mt-3 text-muted-foreground">{content.descriptionsIntro}</p>
        <div class="mt-8 flex flex-col gap-5">
          {content.descriptions.map((text, index) => (
            <article class="feature-card">
              <div class="flex items-start justify-between gap-4">
                <p class="section-kicker">{content.descLabels[index]}</p>
                <button
                  type="button"
                  class="btn-ghost shrink-0 text-xs"
                  data-copy={text}
                  data-copy-label={content.copy}
                  data-copied-label={content.copied}
                >
                  {content.copy}
                </button>
              </div>
              <p class="mt-4 text-[15px] leading-7 text-foreground/90">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="container max-w-6xl">
        <h2 class="text-3xl text-foreground md:text-4xl">{content.storyTitle}</h2>
        <figure class="feature-card mt-8">
          <Quote class="h-7 w-7 text-primary" aria-hidden="true" />
          <blockquote class="mt-5 text-lg leading-8 text-foreground/90 md:text-xl">
            {content.storyQuote}
          </blockquote>
          <figcaption class="mt-4 text-sm text-muted-foreground">{content.storyAttribution}</figcaption>
        </figure>
      </div>
    </section>

    <section class="section-gradient py-16 md:py-20">
      <div class="container max-w-6xl">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/[0.05] text-foreground/70">
          <KeyRound class="h-6 w-6" aria-hidden="true" />
        </div>
        <h2 class="mt-6 text-3xl text-foreground md:text-4xl">{content.byokTitle}</h2>
        <p class="mt-5 max-w-3xl text-[15px] leading-7 text-muted-foreground">{content.byokBody}</p>
        <p class="mt-6 max-w-3xl text-xl leading-8 text-foreground md:text-2xl">{content.byokQuote}</p>
        <p class="mt-4 text-sm text-foreground/45">{content.byokNote}</p>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="container max-w-6xl">
        <h2 class="text-3xl text-foreground md:text-4xl">{content.downloadsTitle}</h2>
        <p class="mt-3 text-muted-foreground">{content.downloadsIntro}</p>

        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {DOWNLOADS.map((item) => {
            const meta = content.downloads[item.key];
            return (
              <li>
                {item.ready && item.href ? (
                  <a
                    href={item.href}
                    download
                    class="feature-card flex items-center gap-4 no-underline transition-colors"
                  >
                    <Download class="h-5 w-5 shrink-0 text-primary" aria-hidden="true" />
                    <span class="flex flex-col">
                      <span class="text-[15px] font-semibold text-foreground">{meta.label}</span>
                      <span class="text-sm text-muted-foreground">{meta.note}</span>
                    </span>
                  </a>
                ) : (
                  <div class="feature-card flex items-center gap-4 opacity-50">
                    <Download class="h-5 w-5 shrink-0 text-foreground/40" aria-hidden="true" />
                    <span class="flex flex-col">
                      <span class="text-[15px] font-semibold text-foreground/70">{meta.label}</span>
                      <span class="text-sm text-muted-foreground">{content.pending}</span>
                    </span>
                  </div>
                )}
              </li>
            );
          })}
        </ul>

        <p class="section-kicker mt-12">{content.screenshotsPreview}</p>
        <div class="mt-5 grid grid-cols-2 gap-4 md:grid-cols-4">
          {SCREENSHOT_SLUGS.map((slug) => (
            <a href={`/screenshots/${shotPrefix}-${slug}.png`} download class="block">
              <img
                src={`/screenshots/${shotPrefix}-${slug}.png`}
                alt=""
                aria-hidden="true"
                loading="lazy"
                class="w-full rounded-xl border border-white/[0.08]"
              />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section-gradient py-16 md:py-20">
      <div class="container max-w-6xl">
        <h2 class="text-3xl text-foreground md:text-4xl">{content.coverageTitle}</h2>
        <ul class="mt-8 flex flex-col gap-3">
          {PRESS_MENTIONS.map((mention) => (
            <li>
              <a
                href={mention.articleUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={getPressMentionLabel(lang, mention)}
                class="feature-card flex items-center gap-4 no-underline"
              >
                <img src={mention.logoSrc} alt="" aria-hidden="true" class="h-5 w-auto shrink-0 opacity-70" />
                <span class="flex flex-col">
                  <span class="text-[15px] text-foreground">{mention.articleTitle}</span>
                  <span class="text-sm text-muted-foreground">{mention.name}</span>
                </span>
                <ExternalLink class="ml-auto h-4 w-4 shrink-0 text-foreground/40" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="container max-w-6xl">
        <h2 class="text-3xl text-foreground md:text-4xl">{content.contactTitle}</h2>
        <p class="mt-4 max-w-3xl text-[15px] leading-7 text-muted-foreground">{content.contactBody}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${PRESS_EMAIL}`} class="btn-primary inline-flex items-center gap-2">
            <Mail class="h-4 w-4" aria-hidden="true" />
            {content.contactCta}
          </a>
          <a href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            {content.storeCtaIos}
          </a>
          <a href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            {content.storeCtaAndroid}
          </a>
        </div>
        <p class="mt-6 text-sm text-foreground/45">{PRESS_EMAIL}</p>
      </div>
    </section>
  </main>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }
      const copied = button.dataset.copiedLabel ?? 'Copied';
      const idle = button.dataset.copyLabel ?? 'Copy';
      button.textContent = copied;
      window.setTimeout(() => {
        button.textContent = idle;
      }, 1600);
    });
  });
</script>
