---
import { getCollection } from 'astro:content';
import {
  ArrowRight,
  BookOpen,
  ChartColumn,
  ChevronDown,
  Droplet,
  HeartPulse,
  LayoutGrid,
  RefreshCw,
  Rocket,
  Scale,
  Settings,
  Sparkles,
  Sun,
  Target,
  Timer,
  Utensils,
} from 'lucide-astro';
import { FAQ_SECTIONS_BY_LANGUAGE } from '@/lib/faqData';
import { HELP_AREA_LABELS, HELP_FAQ_COPY } from '@/lib/helpCopy';
import { docsSections, type HelpArea } from '@/lib/helpTopics';
import { buildLocalizedPath } from '@/lib/localeRouting';
import { useT } from '@/i18n/t';
import type { Language } from '@/i18n/translations';

/**
 * The help home: a large hero pointing to the Intake Docs (docs.getintake.de), where
 * every help topic lives, then one card per docs area linking its topics, then the short
 * pre-purchase FAQ.
 *
 * The FAQ stays native <details>: every answer is in the DOM, crawlable, and matches the
 * FAQPage structured data built from the same faqData.
 */
interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useT(lang);
const faqSections = FAQ_SECTIONS_BY_LANGUAGE[lang];
const copy = HELP_FAQ_COPY[lang];
const homePath = buildLocalizedPath('home', lang);
const areaLabels = HELP_AREA_LABELS[lang];
// Same icons as the docs sidebar chapters (AREA_ICONS in docs-site/scripts/generate.mjs).
const AREA_ICONS: Record<HelpArea, typeof Sun> = {
  'getting-started': Rocket,
  heute: Sun,
  logging: Utensils,
  'recipes-library': BookOpen,
  'goals-budget': Target,
  fasting: Timer,
  water: Droplet,
  'weight-body': Scale,
  stats: ChartColumn,
  health: HeartPulse,
  sync: RefreshCw,
  'widgets-watch-shortcuts': LayoutGrid,
  'intake-ai': Sparkles,
  settings: Settings,
};
const entries = (await getCollection('helpTopics')).map(({ id, data }) => ({
  id: data.id,
  lang: id.split('/')[1] as Language,
  title: data.title,
  draft: data.draft,
}));
const sections = docsSections(entries, lang);
---
<main class="pb-24 pt-32 md:pt-36">
  <section class="section-gradient py-20">
    <div class="container max-w-5xl">
      <div
        data-docs-hero
        class="relative mx-auto max-w-4xl overflow-hidden rounded-xl border border-white/[0.1] bg-white/[0.03] px-6 py-14 text-center md:px-12 md:py-20"
      >
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-primary/15 text-primary">
          <BookOpen class="h-7 w-7" aria-hidden="true" />
        </span>
        <p class="section-kicker mt-6 justify-center">{copy.docsKicker}</p>
        <h1 class="mt-4 text-4xl text-foreground md:text-6xl">{copy.docsTitle}</h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-foreground/60 md:text-lg">{copy.docsBody}</p>
        <a href={copy.docsHref} target="_blank" rel="noopener" data-docs-link class="btn-primary group mx-auto mt-8 w-fit">
          {copy.docsCta}
          <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
      </div>

      {sections.length > 0 && (
        <section data-docs-sections aria-labelledby="help-docs-sections-title" class="mt-12">
          <h2 id="help-docs-sections-title" class="section-kicker">{copy.sectionsTitle}</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {sections.map((section) => {
              const Icon = AREA_ICONS[section.area];
              return (
                <div data-docs-section={section.area} class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-5">
                  <h3 class="flex items-center gap-2.5 text-base font-semibold text-foreground">
                    <Icon class="h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
                    {areaLabels[section.area]}
                  </h3>
                  <ul class="mt-3 space-y-1.5">
                    {section.topics.map((topic) => (
                      <li>
                        <a
                          href={topic.href}
                          target="_blank"
                          rel="noopener"
                          class="text-sm leading-6 text-foreground/60 transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/55"
                        >
                          {topic.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        </section>
      )}

      <section class="mt-16" aria-labelledby="help-faq-title">
        <p class="section-kicker">{copy.faqKicker}</p>
        <h2 id="help-faq-title" class="mt-3 text-2xl font-semibold text-foreground md:text-3xl">{copy.faqTitle}</h2>
        <div class="mt-6 space-y-4">
          {faqSections.map((section) => (
            <details data-faq-section class="group rounded-xl border border-white/[0.08] bg-white/[0.02] px-5">
              <summary class="flex cursor-pointer list-none items-center justify-between py-5 text-left text-lg font-semibold text-foreground [&::-webkit-details-marker]:hidden">
                <span>{section.title}</span>
                <ChevronDown class="h-5 w-5 shrink-0 text-foreground/40 transition-transform group-open:rotate-180" />
              </summary>
              <div class="pb-5">
                {section.items.map((item) => (
                  <details data-faq-item class="group/item border-t border-white/[0.06]">
                    <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-left text-sm font-semibold text-foreground [&::-webkit-details-marker]:hidden">
                      <span>{item.question}</span>
                      <ChevronDown class="h-4 w-4 shrink-0 text-foreground/40 transition-transform group-open/item:rotate-180" />
                    </summary>
                    <p class="pb-4 text-sm leading-relaxed text-foreground/50">{item.answer}</p>
                  </details>
                ))}
              </div>
            </details>
          ))}
        </div>
      </section>

      <div class="mt-12 rounded-xl border border-white/[0.08] bg-white/[0.025] p-8 text-center">
        <p class="section-kicker justify-center">{t('download')}</p>
        <h2 class="mt-3 text-2xl font-semibold text-foreground md:text-3xl">{t('helpCtaTitle')}</h2>
        <p class="mt-3 text-sm leading-6 text-foreground/50 md:text-base">{t('helpCtaDescription')}</p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a href={`${homePath}#hero`} class="trust-chip-link">{t('helpCtaButton')}</a>
          <a href={buildLocalizedPath('features', lang)} class="trust-chip-link">{t('featuresNav')}</a>
          <a href={buildLocalizedPath('comparisons', lang)} class="trust-chip-link">{t('comparisonsNav')}</a>
        </div>
      </div>
    </div>
  </section>
</main>
