---
import { buildLocalizedPath } from '@/lib/localeRouting';
import type { ReleaseSummary } from '@/lib/releases';
import type { Language } from '@/i18n/translations';

interface Props {
  lang: Language;
  releases: ReleaseSummary[];
}

const { lang, releases } = Astro.props;
const entries = releases.slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const copy = {
  de: {
    kicker: 'Neueste Releases',
    title: 'Produktupdates',
    subtitle:
      'Bleibt auf dem neusten Stand und schaut euch an, was sich mit jedem Update geändert hat',
    all: 'Alle Updates ansehen',
    read: 'Update lesen',
  },
  en: {
    kicker: 'Latest releases',
    title: 'Product Updates',
    subtitle: 'Stay up to date with the newest features in each update',
    all: 'View all updates',
    read: 'Read update',
  },
}[lang];
---
{entries.length > 0 && (
  <section class="section-gradient py-20">
    <div class="container space-y-8">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl space-y-3">
          <p class="section-kicker">{copy.kicker}</p>
          <h2 class="text-3xl text-foreground md:text-5xl">{copy.title}</h2>
          <p class="text-base text-foreground/50 md:text-lg">{copy.subtitle}</p>
        </div>

        <a href={buildLocalizedPath('whatsNewIndex', lang)} class="btn-secondary shrink-0">
          {copy.all}
        </a>
      </div>

      <div class="reveal grid gap-6 lg:grid-cols-3">
        {entries.map((entry) => (
          <a
            href={entry.href}
            class="group block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/55 focus-visible:ring-offset-4 focus-visible:ring-offset-background"
          >
            <article class="glass-card h-full overflow-hidden transition-colors group-hover:border-white/[0.16]">
              <img src={entry.coverImage} alt={entry.title} class="h-48 w-full object-cover" />
              <div class="space-y-4 p-6">
                <div class="space-y-2">
                  <p class="section-kicker">Version {entry.version}</p>
                  <p class="text-sm text-foreground/40">
                    {dateFormatter.format(new Date(entry.publishedAt))}
                  </p>
                  <h3 class="text-lg font-semibold text-foreground">{entry.title}</h3>
                  <p class="text-sm leading-6 text-foreground/50">{entry.summary}</p>
                </div>

                {entry.highlights.length > 0 && (
                  <ul class="grid gap-2 text-sm text-foreground/80">
                    {entry.highlights.slice(0, 2).map((highlight) => (
                      <li class="rounded-lg border border-white/[0.08] bg-white/[0.02] px-4 py-3">
                        {highlight}
                      </li>
                    ))}
                  </ul>
                )}

                <span class="inline-flex items-center text-sm font-medium text-primary">
                  {copy.read}
                </span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
