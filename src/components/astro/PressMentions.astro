---
import { getPressMentionLabel, PRESS_MENTIONS } from '@/lib/pressMentions';
import { useT } from '@/i18n/t';
import type { Language } from '@/i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useT(lang);
---
<section class="border-y border-white/[0.06] py-6">
  <div class="container">
    <div class="flex flex-col items-center gap-4 md:flex-row md:gap-8">
      <p class="section-kicker">{t('pressMentionsLabel')}</p>

      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 md:justify-start">
        {PRESS_MENTIONS.map((mention) => (
          <a
            href={mention.articleUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={getPressMentionLabel(lang, mention)}
            class="flex items-center gap-2 opacity-55 transition-opacity duration-200 hover:opacity-100"
          >
            <img
              src={mention.logoSrc}
              alt=""
              aria-hidden="true"
              class="h-5 w-auto text-foreground md:h-6"
            />
            {mention.visibleLabel && (
              <span class="text-[13px] font-medium text-foreground/60">{mention.visibleLabel}</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
