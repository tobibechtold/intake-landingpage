---
import { getScreenshotAsset } from '@/lib/screenshotAssets';
import { useT } from '@/i18n/t';
import type { Language } from '@/i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useT(lang);

const addFood = getScreenshotAsset(lang, 'addFood');
const statistics = getScreenshotAsset(lang, 'statistics');
const dashboard = getScreenshotAsset(lang, 'dashboard');

const stories = [
  {
    title: t('proofStoryTrackFastTitle'),
    body: t('proofStoryTrackFastBody'),
    points: [
      t('proofStoryTrackFastPointOne'),
      t('proofStoryTrackFastPointTwo'),
      t('proofStoryTrackFastPointThree'),
    ],
    image: addFood.src,
    alt: addFood.alt,
  },
  {
    title: t('proofStorySeeMattersTitle'),
    body: t('proofStorySeeMattersBody'),
    points: [
      t('proofStorySeeMattersPointOne'),
      t('proofStorySeeMattersPointTwo'),
      t('proofStorySeeMattersPointThree'),
    ],
    image: statistics.src,
    alt: statistics.alt,
  },
  {
    title: t('proofStoryStayControlTitle'),
    body: t('proofStoryStayControlBody'),
    points: [
      t('proofStoryStayControlPointOne'),
      t('proofStoryStayControlPointTwo'),
      t('proofStoryStayControlPointThree'),
    ],
    image: dashboard.src,
    alt: dashboard.alt,
  },
];
---
<section class="section-gradient py-20 md:py-24">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center">
      <p class="section-kicker justify-center">{t('comparisonIntake')}</p>
      <h2 class="mt-4 text-3xl text-foreground md:text-5xl">{t('proofStoriesTitle')}</h2>
      <p class="mt-4 text-base text-foreground/50 md:text-lg">{t('proofStoriesSubtitle')}</p>
    </div>

    <div class="mt-12 space-y-8">
      {stories.map((story, index) => (
        <article
          class:list={[
            'proof-story-card reveal',
            index % 2 === 1 && 'md:[&>.proof-story-media]:order-2',
          ]}
        >
          <div class="proof-story-media">
            <img
              src={story.image}
              alt={story.alt}
              loading="lazy"
              decoding="async"
              class="w-full rounded-xl border border-white/[0.08] bg-black/20 object-cover"
            />
          </div>
          <div class="proof-story-copy">
            <h3 class="text-2xl font-semibold text-foreground md:text-3xl">{story.title}</h3>
            <p class="mt-4 text-base leading-7 text-foreground/50">{story.body}</p>
            <ul class="mt-6 grid gap-3">
              {story.points.map((point) => (
                <li class="rounded-lg border border-white/[0.08] bg-white/[0.02] px-4 py-3 text-sm font-medium text-foreground/85">
                  {point}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
