---
import { Shield, Barcode, Heart, Database, Cloud, Target, Droplets, Clock3, BarChart3 } from 'lucide-astro';
import { useT } from '@/i18n/t';
import type { Language, TranslationKey } from '@/i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useT(lang);

const features = [
  { icon: Shield, titleKey: 'privacyFirst', descKey: 'privacyFirstDesc' },
  { icon: Target, titleKey: 'reachGoals', descKey: 'reachGoalsDesc' },
  { icon: Database, titleKey: 'millionFoods', descKey: 'millionFoodsDesc' },
  { icon: Barcode, titleKey: 'barcodeScanner', descKey: 'barcodeScannerDesc' },
  { icon: Heart, titleKey: 'appleHealthSync', descKey: 'appleHealthSyncDesc' },
  { icon: Cloud, titleKey: 'icloudSync', descKey: 'icloudSyncDesc' },
  { icon: BarChart3, titleKey: 'nutrientStats', descKey: 'nutrientStatsDesc' },
  { icon: Clock3, titleKey: 'fastingTracking', descKey: 'fastingTrackingDesc' },
  { icon: Droplets, titleKey: 'waterTracking', descKey: 'waterTrackingDesc' },
] satisfies ReadonlyArray<{ icon: unknown; titleKey: TranslationKey; descKey: TranslationKey }>;
---
<section class="section-gradient py-24">
  <div class="container">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl text-foreground md:text-4xl">
        {t('featuresTitle')} <span class="gradient-text">{t('featuresTitleHighlight')}</span>
      </h2>
      <p class="mx-auto max-w-xl text-lg text-foreground/50">{t('featuresSubtitle')}</p>
    </div>

    <div class="reveal grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <div class="feature-card">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-lg bg-white/[0.05]">
            <feature.icon class="h-5 w-5 text-foreground/70" />
          </div>
          <h3 class="mb-2 text-lg font-semibold text-foreground">{t(feature.titleKey)}</h3>
          <p class="text-sm leading-relaxed text-foreground/50">{t(feature.descKey)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
