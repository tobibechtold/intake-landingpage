---
import { ArrowRight, Sparkles } from 'lucide-astro';
import { buildLocalizedPath } from '@/lib/localeRouting';
import { useT } from '@/i18n/t';
import type { Language } from '@/i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useT(lang);
---
<section data-testid="mobile-intake-ai-banner" class="section-gradient py-5 md:hidden">
  <div class="container">
    <a
      href={buildLocalizedPath('intakeAI', lang)}
      class="group flex items-center gap-4 rounded-xl border border-white/[0.08] bg-white/[0.025] p-4 transition-colors hover:border-white/[0.16]"
    >
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
        <Sparkles class="h-5 w-5" />
      </span>
      <span class="min-w-0 flex-1">
        <span class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-foreground/45">
          {t('intakeAITeaserKicker')}
        </span>
        <span class="mt-1 block text-sm font-semibold leading-5 text-foreground">
          {t('intakeAITeaserDescription')}
        </span>
        <span class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-primary">
          {t('intakeAITeaserButton')}
          <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
        </span>
      </span>
    </a>
  </div>
</section>
