---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteShell from '@/components/astro/SiteShell.astro';
import { pageProps } from '@/lib/pageSeo';
import NotFound from '@/pages-react/NotFound';

const route = '/404';
---
<BaseLayout route={route}>
  <SiteShell route={route}>
    {/* No client: directive — this page is static, so it ships no JavaScript. */}
    <NotFound {...pageProps(route)} />
  </SiteShell>
</BaseLayout>
