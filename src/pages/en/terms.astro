---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteShell from '@/components/astro/SiteShell.astro';
import Terms from '@/components/astro/Terms.astro';
import { pageProps } from '@/lib/pageSeo';

const route = '/en/terms';
const { lang } = pageProps(route);
---
<BaseLayout route={route}>
  <SiteShell route={route}>
    <Terms lang={lang} />
  </SiteShell>
</BaseLayout>
