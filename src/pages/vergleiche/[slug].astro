---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteShell from '@/components/astro/SiteShell.astro';
import { pageProps } from '@/lib/pageSeo';
import ComparisonDetailPage from '@/pages-react/ComparisonDetailPage';

export function getStaticPaths() {
  return [
    { params: { slug: 'yazio-alternative' } },
    { params: { slug: 'fddb-alternative' } },
  ];
}

const { slug } = Astro.params;
const route = `/vergleiche/${slug}`;
---
<BaseLayout route={route}>
  <SiteShell route={route}>
    <ComparisonDetailPage {...pageProps(route)} slug={slug!} />
  </SiteShell>
</BaseLayout>
