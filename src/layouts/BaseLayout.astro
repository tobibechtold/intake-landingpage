---
import { getHreflangPair, getPageSeo, SITE_ORIGIN } from '@/lib/pageSeo';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '@/index.css';

interface Props {
  route: string;
  /** Overrides for routes whose metadata is per-entry, e.g. /whats-new/2.5.1. */
  title?: string;
  description?: string;
}

const { route, title, description } = Astro.props;
const seo = getPageSeo(route);
const pair = getHreflangPair(route);

const pageTitle = title ?? seo.title;
const pageDescription = description ?? seo.description;
const ogImage = new URL('/og-image.png', SITE_ORIGIN).href;
---
<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={seo.canonical} />
    {pair && (
      <>
        <link rel="alternate" hreflang="de" href={new URL(pair.de, SITE_ORIGIN).href} />
        <link rel="alternate" hreflang="en" href={new URL(pair.en, SITE_ORIGIN).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(pair.de, SITE_ORIGIN).href} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:locale" content={seo.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Carried over verbatim from the deleted index.html. Every tag below was live
         in production; dropping any of them is a silent regression. -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <!-- iOS Safari Smart App Banner: a direct install path on an app landing page. -->
    <meta name="apple-itunes-app" content="app-id=6757768955" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Intake" />
  </head>
  <body>
    <slot />

    {/* Formerly rendered from App.tsx / main.tsx, both deleted in the migration.
        Without these there is no PostHog, no Vercel Analytics, no Speed Insights,
        and — most importantly — no UTM capture feeding bio-link attribution. */}
    <Analytics />
    <SpeedInsights />
    <script>
      import '@/scripts/bootstrap';
    </script>

    {/*
      Pins the visitor's language choice so the root locale redirect in vercel.json
      stops firing for them. The redirect is guarded by `missing: cookie intake_lang`,
      so this is what makes an explicit switch stick. Delegated and inline so it works
      without hydrating the language switcher, which is a plain anchor.
    */}
    <script is:inline>
      document.addEventListener(
        'click',
        (event) => {
          const target = event.target instanceof Element
            ? event.target.closest('[data-language-switch]')
            : null;
          if (!target) return;
          const next = target.getAttribute('data-language-switch');
          if (next !== 'de' && next !== 'en') return;
          document.cookie =
            `intake_lang=${next};path=/;max-age=31536000;samesite=lax`;
        },
        { capture: true },
      );
    </script>
  </body>
</html>
